# Copy to .env and fill in. Never commit .env.   docker compose up --build
POSTGRES_PASSWORD=change-me
JWT_SECRET=generate-with: python -c "import secrets;print(secrets.token_urlsafe(48))"
EXECUTOR_KEY=generate-with: python -c "import secrets;print(secrets.token_urlsafe(32))"
METRICS_TOKEN=        # bearer token for /metrics (Prometheus). Leave blank to disable scraping.
LB_PORT=8080
SANDBOX_WORKDIR=/srv/nexora-work   # host dir (mkdir -m 777) mounted at the SAME path into the executor so sibling sandbox containers can see it
# Public origin(s) of the site, JSON list. Same-origin deployments (the default) do not need CORS at all.
CORS_ORIGINS=["http://localhost:8080"]
# LLM providers: leave blank to run the mentor in offline mode. Any subset works; the order is CODEMIND_LLM_CHAIN.
GEMINI_API_KEY=       # Google AI Studio (free tier)
GROQ_API_KEY=         # console.groq.com (free tier)
OPENROUTER_API_KEY=   # openrouter.ai (some :free models)
ANTHROPIC_API_KEY=
# Email (verification / password reset / notifications). Blank = emails are logged, not sent.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=nexora@localhost
# Sizing. Defaults need ~3 GB RAM. For a 1-2 GB free VM use: API_REPLICAS=1 WEB_REPLICAS=1 WEB_CONCURRENCY=1
API_REPLICAS=3
WEB_REPLICAS=2
WORKER_REPLICAS=1
# EXECUTOR_URL=http://runner.internal:9000    # run the sandbox on a separate host (recommended for production)
# Observability profile
GRAFANA_PASSWORD=admin
# Production overlay (docker-compose.prod.yml)
DOMAIN=localhost
IMAGE_REGISTRY=ghcr.io/OWNER/nexora
IMAGE_TAG=latest
